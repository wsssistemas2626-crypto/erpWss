{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/worker/src",
  "tags": ["type:app", "scope:worker"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/worker"],
      "options": {
        "parallel": false,
        "commands": [
          "tsc -p apps/worker/tsconfig.app.json",
          "tsc-alias -p apps/worker/tsconfig.app.json"
        ]
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": true,
        "commands": [
          "tsc -p apps/worker/tsconfig.app.json --watch --preserveWatchOutput",
          "tsc-alias -p apps/worker/tsconfig.app.json --watch",
          "node --watch --enable-source-maps dist/worker/apps/worker/src/main.js"
        ]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/worker --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/worker/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/worker"
      }
    }
  }
}
