{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/api"],
      "options": {
        "parallel": false,
        "commands": ["tsc -p apps/api/tsconfig.app.json", "tsc-alias -p apps/api/tsconfig.app.json"]
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": true,
        "commands": [
          "tsc -p apps/api/tsconfig.app.json --watch --preserveWatchOutput",
          "tsc-alias -p apps/api/tsconfig.app.json --watch",
          "node --watch --enable-source-maps dist/api/apps/api/src/main.js"
        ]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/api --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/api/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/api"
      }
    }
  }
}
