{
  "name": "platform-tenancy",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/platform/tenancy/src",
  "tags": ["type:platform", "scope:platform"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
